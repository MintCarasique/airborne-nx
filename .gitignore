/[[]XBOX360[]]*/
/AUDIO_TS/
/VIDEO_TS/
/extracted/
/generated/
/rex/generated/default/
/rex/out/
/dist/
/tools/toolchain/
/tools/XenonRecomp/
/tools/XenosRecomp/
/tools/reference-nfsmw/
/tools/reference-nfsmw-dk/
