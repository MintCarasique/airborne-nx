# Analysis: keep only human-written docs, recovered tables and small results.
# Raw logs, hardware dumps, generated JSON reports and copied third-party
# sources stay local.
/analysis/*
!/analysis/*.md
!/analysis/*.toml
# XenonAnalyse output, recreated by tools/recompile.ps1 -Analyse.
/analysis/airborne_switch_tables*.toml
!/analysis/image/
/analysis/image/*
!/analysis/image/*.tsv
!/analysis/hardware/
/analysis/hardware/*
!/analysis/hardware/*_result.json
*.log
.vs/
build/
