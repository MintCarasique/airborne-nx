 bool build_sync(BuilderContext& ctx) {
-  // Memory barrier, x86 has strong ordering so this is a no-op
-  (void)ctx;
+  // Memory barrier. x86 orders memory strongly enough (REX_FENCE is only a compiler barrier there),
+  // but ARM does not: without a hardware fence, a lock-free producer/consumer (UE3's rendering
+  // command queue) lets the consumer see the advanced write pointer before the command it covers.
+  ctx.println("	REX_FENCE();");
