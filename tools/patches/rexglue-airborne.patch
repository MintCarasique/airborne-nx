+void VulkanCommandProcessor::SetGpuTimingTransfer(uint32_t key, uint64_t pixel_area,
+                                                  uint32_t draw_count) {
+  if (!gpu_timing_current_slot_) {
+    return;
+  }
+  key = std::min(key, kGpuTimingTransferKeyCount - 1);
+  gpu_timing_transfer_draws_[key] += draw_count;
+  gpu_timing_transfer_pixels_[key] += pixel_area;
+  SetGpuTimingCategory(GpuTimingCategory::kTransfer, key);
