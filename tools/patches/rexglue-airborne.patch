+  for (auto it = std::filesystem::recursive_directory_iterator(override_root, ec);
+       !ec && it != std::filesystem::recursive_directory_iterator(); it.increment(ec)) {
+    if (!it->is_regular_file(ec)) {
+      continue;
+    }
+    std::string relative = rex::path_to_utf8(std::filesystem::relative(it->path(), override_root, ec));
+    std::replace(relative.begin(), relative.end(), '/', '\\');
+    auto* entry = static_cast<HostPathEntry*>(root_entry_->ResolvePath(relative));
+    if (!entry || (entry->attributes_ & kFileAttributeDirectory)) {
+      REXFS_WARN("[io] override {} has no file to replace in {}", relative, mount_path_);
+      continue;
+    }
+    const auto size = size_t(std::filesystem::file_size(it->path(), ec));
+    entry->host_path_ = it->path();
+    entry->size_ = size;
+    entry->allocation_size_ = rex::round_up(size, size_t(4096));
+    REXFS_INFO("[io] override: {} <- {} ({} bytes)", relative, rex::path_to_utf8(it->path()), size);
+    ++applied;
+  }
+  return applied;
+}
+
 void HostPathDevice::Dump(string::StringBuffer* string_buffer) {
   auto global_lock = global_critical_region_.Acquire();
   root_entry_->Dump(string_buffer, 0);
