+void VulkanCommandProcessor::SetGpuTimingCategory(GpuTimingCategory category) {
+  if (!gpu_timing_current_slot_ || category == gpu_timing_current_category_) {
+    return;
+  }
+  GpuTimingSlot& slot = *gpu_timing_current_slot_;
+  // Keep one query for the final timestamp.
+  if (slot.segments.size() + 1 >= kGpuTimingQueriesPerSlot) {
+    slot.overflowed = true;
+    // Stop recording for this submission.
+    gpu_timing_current_slot_ = nullptr;
+    return;
+  }
+  // The timestamp ends the segment of the previous category.
+  deferred_command_buffer_.CmdVkWriteTimestamp(
+      VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_timing_pool_,
+      gpu_timing_current_slot_index_ * kGpuTimingQueriesPerSlot + uint32_t(slot.segments.size()));
+  slot.segments.push_back({gpu_timing_current_category_, gpu_timing_vs_hash_, gpu_timing_ps_hash_});
+  gpu_timing_current_category_ = category;
+}
+
+bool VulkanCommandProcessor::BeginGpuTimingSubmission() {
+  gpu_timing_current_slot_ = nullptr;
+  gpu_timing_current_category_ = GpuTimingCategory::kOther;
+  if (REXCVAR_GET(gpu_timing) <= 0 || gpu_timing_init_failed_) {
+    return false;
+  }
+
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDevice device = vulkan_device->device();
+
+  if (gpu_timing_pool_ == VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanInstance::Functions& ifn =
+        vulkan_device->vulkan_instance()->functions();
+    VkPhysicalDevice physical_device = vulkan_device->physical_device();
+    VkPhysicalDeviceProperties device_properties;
+    ifn.vkGetPhysicalDeviceProperties(physical_device, &device_properties);
+    uint32_t queue_family_count = 0;
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count, nullptr);
+    std::vector<VkQueueFamilyProperties> queue_families(queue_family_count);
+    ifn.vkGetPhysicalDeviceQueueFamilyProperties(physical_device, &queue_family_count,
+                                                 queue_families.data());
+    uint32_t valid_bits = 0;
+    uint32_t queue_family = vulkan_device->queue_family_graphics_compute();
+    if (queue_family < queue_family_count) {
+      valid_bits = queue_families[queue_family].timestampValidBits;
+    }
+    if (!valid_bits) {
+      REXGPU_WARN("[gputime] The graphics queue family doesn't support timestamps, disabled");
+      gpu_timing_init_failed_ = true;
+      return false;
+    }
+    VkQueryPoolCreateInfo pool_info = {};
+    pool_info.sType = VK_STRUCTURE_TYPE_QUERY_POOL_CREATE_INFO;
+    pool_info.queryType = VK_QUERY_TYPE_TIMESTAMP;
+    pool_info.queryCount = kGpuTimingSlots * kGpuTimingQueriesPerSlot;
+    if (dfn.vkCreateQueryPool(device, &pool_info, nullptr, &gpu_timing_pool_) != VK_SUCCESS) {
+      REXGPU_WARN("[gputime] Failed to create the timestamp query pool, disabled");
+      gpu_timing_pool_ = VK_NULL_HANDLE;
+      gpu_timing_init_failed_ = true;
+      return false;
+    }
+    gpu_timing_period_ns_ = double(device_properties.limits.timestampPeriod);
+    gpu_timing_valid_mask_ = valid_bits >= 64 ? UINT64_MAX : ((UINT64_C(1) << valid_bits) - 1);
+    gpu_timing_results_temp_.resize(kGpuTimingQueriesPerSlot);
+    REXGPU_INFO("[gputime] Enabled: timestampPeriod {} ns, {} valid bits, {} queries per submission",
+                gpu_timing_period_ns_, valid_bits, kGpuTimingQueriesPerSlot);
+  }
+
+  const uint64_t submission = GetCurrentSubmission();
+  const uint32_t slot_index = uint32_t(submission % kGpuTimingSlots);
+  GpuTimingSlot& slot = gpu_timing_slots_[slot_index];
+  if (slot.in_use) {
+    // The slot's previous submission hasn't been read back yet (too many in flight).
+    ++gpu_timing_overflows_;
+    return false;
+  }
+  slot.in_use = true;
+  slot.submission = submission;
+  slot.overflowed = false;
+  slot.segments.clear();
+  slot.segments.reserve(256);
+
+  // The whole slice is reset as the number of previously used queries isn't tracked; this is at
+  // the start of the command buffer, outside of a render pass.
+  const uint32_t first_query = slot_index * kGpuTimingQueriesPerSlot;
+  deferred_command_buffer_.CmdVkResetQueryPool(gpu_timing_pool_, first_query,
+                                               kGpuTimingQueriesPerSlot);
+  deferred_command_buffer_.CmdVkWriteTimestamp(VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT,
+                                               gpu_timing_pool_, first_query);
+  // Segment 0 has no duration, it only starts the chain.
+  slot.segments.push_back({GpuTimingCategory::kOther, 0, 0});
+  gpu_timing_current_slot_ = &slot;
+  gpu_timing_current_slot_index_ = slot_index;
+  return true;
+}
+
+void VulkanCommandProcessor::EndGpuTimingSubmission() {
+  if (!gpu_timing_current_slot_) {
+    return;
+  }
+  GpuTimingSlot& slot = *gpu_timing_current_slot_;
+  if (slot.segments.size() < kGpuTimingQueriesPerSlot) {
+    deferred_command_buffer_.CmdVkWriteTimestamp(
+        VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, gpu_timing_pool_,
+        gpu_timing_current_slot_index_ * kGpuTimingQueriesPerSlot + uint32_t(slot.segments.size()));
+    slot.segments.push_back(
+        {gpu_timing_current_category_, gpu_timing_vs_hash_, gpu_timing_ps_hash_});
+  }
+  gpu_timing_current_slot_ = nullptr;
+  gpu_timing_current_category_ = GpuTimingCategory::kOther;
+}
+
+void VulkanCommandProcessor::ProcessCompletedGpuTiming() {
+  if (gpu_timing_pool_ == VK_NULL_HANDLE) {
+    return;
+  }
+  const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+  const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+  VkDevice device = vulkan_device->device();
+  const double ns_per_tick = gpu_timing_period_ns_ * REXCVAR_GET(gpu_timing_scale);
+  for (uint32_t slot_index = 0; slot_index < kGpuTimingSlots; ++slot_index) {
+    GpuTimingSlot& slot = gpu_timing_slots_[slot_index];
+    if (!slot.in_use || slot.submission > submission_completed_) {
+      continue;
+    }
+    const uint32_t count = uint32_t(slot.segments.size());
+    if (slot.overflowed) {
+      ++gpu_timing_overflows_;
+    }
+    if (count >= 2) {
+      // The submission is complete, so no waiting is needed.
+      VkResult result = dfn.vkGetQueryPoolResults(
+          device, gpu_timing_pool_, slot_index * kGpuTimingQueriesPerSlot, count,
+          sizeof(uint64_t) * count, gpu_timing_results_temp_.data(), sizeof(uint64_t),
+          VK_QUERY_RESULT_64_BIT);
+      if (result == VK_SUCCESS) {
+        const bool per_pair = REXCVAR_GET(gpu_timing) >= 2;
+        for (uint32_t i = 1; i < count; ++i) {
+          uint64_t ticks = (gpu_timing_results_temp_[i] - gpu_timing_results_temp_[i - 1]) &
+                           gpu_timing_valid_mask_;
+          double ns = double(ticks) * ns_per_tick;
+          const GpuTimingSegment& segment = slot.segments[i];
+          gpu_timing_category_ns_[size_t(segment.category)] += ns;
+          if (per_pair && segment.category == GpuTimingCategory::kDraw &&
+              (segment.vs_hash || segment.ps_hash)) {
+            GpuTimingShaderPairTotals& totals =
+                gpu_timing_pairs_[std::make_pair(segment.vs_hash, segment.ps_hash)];
+            totals.ns += ns;
+            ++totals.draws;
+          }
+        }
+      } else {
+        REXGPU_WARN("[gputime] vkGetQueryPoolResults failed: {}", int32_t(result));
+      }
+    }
+    slot.in_use = false;
+    slot.segments.clear();
+  }
+}
+
+void VulkanCommandProcessor::ReportGpuTiming() {
+  auto now = std::chrono::steady_clock::now();
+  if (!gpu_timing_report_started_) {
+    gpu_timing_report_started_ = true;
+    gpu_timing_report_time_ = now;
+    return;
+  }
+  int32_t interval_s = std::max(REXCVAR_GET(gpu_timing_interval_s), int32_t(1));
+  if (now - gpu_timing_report_time_ < std::chrono::seconds(interval_s)) {
+    return;
+  }
+  gpu_timing_report_time_ = now;
+  if (!gpu_timing_frames_) {
+    return;
+  }
+  const double frames = double(gpu_timing_frames_);
+  const double to_ms = 1e-6 / frames;
+  double total_ns = 0.0;
+  for (double ns : gpu_timing_category_ns_) {
+    total_ns += ns;
+  }
+  REXGPU_INFO(
+      "[gputime] {} frames: per frame draw {:.3f} ms, transfer {:.3f} ms, resolve {:.3f} ms, "
+      "other {:.3f} ms, total {:.3f} ms (scale {}, overflows {})",
+      gpu_timing_frames_, gpu_timing_category_ns_[size_t(GpuTimingCategory::kDraw)] * to_ms,
+      gpu_timing_category_ns_[size_t(GpuTimingCategory::kTransfer)] * to_ms,
+      gpu_timing_category_ns_[size_t(GpuTimingCategory::kResolve)] * to_ms,
+      gpu_timing_category_ns_[size_t(GpuTimingCategory::kOther)] * to_ms, total_ns * to_ms,
+      REXCVAR_GET(gpu_timing_scale), gpu_timing_overflows_);
+  if (!gpu_timing_pairs_.empty()) {
+    std::vector<std::pair<std::pair<uint64_t, uint64_t>, GpuTimingShaderPairTotals>> sorted(
+        gpu_timing_pairs_.begin(), gpu_timing_pairs_.end());
+    std::sort(sorted.begin(), sorted.end(),
+              [](const auto& a, const auto& b) { return a.second.ns > b.second.ns; });
+    for (size_t i = 0; i < std::min(sorted.size(), size_t(12)); ++i) {
+      REXGPU_INFO("[gputime]   VS {:016X} PS {:016X}: {:.3f} ms/frame, {:.1f} draws/frame",
+                  sorted[i].first.first, sorted[i].first.second, sorted[i].second.ns * to_ms,
+                  double(sorted[i].second.draws) / frames);
+    }
+  }
+  std::fill(std::begin(gpu_timing_category_ns_), std::end(gpu_timing_category_ns_), 0.0);
+  gpu_timing_pairs_.clear();
+  gpu_timing_frames_ = 0;
+  gpu_timing_overflows_ = 0;
+}
+
+void VulkanCommandProcessor::ShutdownGpuTiming() {
+  gpu_timing_current_slot_ = nullptr;
+  if (gpu_timing_pool_ != VK_NULL_HANDLE) {
+    const ui::vulkan::VulkanDevice* vulkan_device = GetVulkanDevice();
+    const ui::vulkan::VulkanDevice::Functions& dfn = vulkan_device->functions();
+    dfn.vkDestroyQueryPool(vulkan_device->device(), gpu_timing_pool_, nullptr);
+  }
+  gpu_timing_pool_ = VK_NULL_HANDLE;
+  for (GpuTimingSlot& slot : gpu_timing_slots_) {
+    slot.in_use = false;
+    slot.segments.clear();
+  }
+}
