diff --git a/sdk/include/rex/ppc/memcalls.h b/sdk/include/rex/ppc/memcalls.h
new file mode 100644
index 0000000..ca952dc
--- /dev/null
+++ b/sdk/include/rex/ppc/memcalls.h
@@ -0,0 +1,90 @@
+/**
+ * @file        rex/ppc/memcalls.h
+ * @brief       The pure parts of the inline constant-size memcpy / memset (from sasrt-nx, 2026-10-14; banjo-nx's copy)
+ *
+ * tools/inline_memcalls.py writes the C runtime's memcpy / memset calls whose size is a constant of 1-64 bytes as
+ * REX_MEMCPY_CONST / REX_MEMSET_CONST (sa2-nx's idea 6, sonic-unleashed-nx's SWITCH_INLINE_MEMCPY). The helpers that
+ * touch guest memory live in the generated pch (they need its address macros); what they decide with lives here, so
+ * sdk/tests/memcalls_test.cpp tests the same code.
+ *
+ * banjo-nx's addition (the same test its hand-written memcpy, app/src/cpu/hot/banjo_hand_natives.h, makes): the CRT
+ * memcpy stores r3 at -8(r1) first and reloads r3 from there at every return, so a destination that covers that slot
+ * returns copied bytes in r3. CoversSlot declines it (the original runs).
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::ppc {
+
+/// A guest range of N bytes the inline helpers may handle: not in 0x7F000000-0x7FFFFFFF (hardware registers, where
+/// the width of each write matters) or from 0xA0000000 (the physical views, which alias each other: two different
+/// guest addresses can be the same memory), and not wrapping around 4 GB. Anything else runs the original routine.
+template <uint32_t N>
+[[gnu::always_inline]] inline bool PlainRange(uint32_t x) noexcept {
+  static_assert(N >= 1 && N <= 64);
+  const uint32_t e = x + (N - 1);
+  if (e < x) return false;
+  if (x < 0x7F000000u) return e < 0x7F000000u;
+  return x >= 0x80000000u && e < 0xA0000000u;
+}
+
+/// The CRT memcpy copies forward, unit by unit with each unit's loads before its stores: for dst <= src that is what
+/// memmove gives, for dst > src with overlapping ranges it smears already-copied bytes. The helper copies like
+/// memmove, so that case must run the original: true when dst > src and dst - src < N.
+template <uint32_t N>
+[[gnu::always_inline]] inline bool CopySmears(uint32_t dst, uint32_t src) noexcept {
+  return uint32_t(dst - src - 1u) < N - 1u;
+}
+
+/// True when [dst, dst + N) overlaps the 8-byte save slot [slot, slot + 8) (slot = r1 - 8).
+template <uint32_t N>
+[[gnu::always_inline]] inline bool CoversSlot(uint32_t dst, uint32_t slot) noexcept {
+  return uint64_t(uint32_t(slot + 7u - dst)) < uint64_t(N) + 7u;
+}
+
+/// N bytes, 1 <= N <= 64, every load before every store (two to eight loads and as many stores, overlapping where N
+/// is not a power of two).
+template <uint32_t N>
+[[gnu::always_inline]] inline void CopyConst(uint8_t* d, const uint8_t* s) noexcept {
+  static_assert(N >= 1 && N <= 64);
+  if constexpr (N > 32) {
+    uint8_t a[16], b[16], c[16], e[16];
+    __builtin_memcpy(a, s, 16);
+    __builtin_memcpy(b, s + 16, 16);
+    __builtin_memcpy(c, s + N - 32, 16);
+    __builtin_memcpy(e, s + N - 16, 16);
+    __builtin_memcpy(d, a, 16);
+    __builtin_memcpy(d + 16, b, 16);
+    __builtin_memcpy(d + N - 32, c, 16);
+    __builtin_memcpy(d + N - 16, e, 16);
+  } else if constexpr (N >= 16) {
+    uint8_t a[16], e[16];
+    __builtin_memcpy(a, s, 16);
+    __builtin_memcpy(e, s + N - 16, 16);
+    __builtin_memcpy(d, a, 16);
+    __builtin_memcpy(d + N - 16, e, 16);
+  } else if constexpr (N >= 8) {
+    uint64_t a, e;
+    __builtin_memcpy(&a, s, 8);
+    __builtin_memcpy(&e, s + N - 8, 8);
+    __builtin_memcpy(d, &a, 8);
+    __builtin_memcpy(d + N - 8, &e, 8);
+  } else if constexpr (N >= 4) {
+    uint32_t a, e;
+    __builtin_memcpy(&a, s, 4);
+    __builtin_memcpy(&e, s + N - 4, 4);
+    __builtin_memcpy(d, &a, 4);
+    __builtin_memcpy(d + N - 4, &e, 4);
+  } else if constexpr (N >= 2) {
+    uint16_t a, e;
+    __builtin_memcpy(&a, s, 2);
+    __builtin_memcpy(&e, s + N - 2, 2);
+    __builtin_memcpy(d, &a, 2);
+    __builtin_memcpy(d + N - 2, &e, 2);
+  } else {
+    *d = *s;
+  }
+}
+
+}  // namespace rex::ppc
diff --git a/sdk/include/rex/ppc/vec_unaligned.h b/sdk/include/rex/ppc/vec_unaligned.h
new file mode 100644
index 0000000..da20c55
--- /dev/null
+++ b/sdk/include/rex/ppc/vec_unaligned.h
@@ -0,0 +1,75 @@
+/**
+ * @file        rex/ppc/vec_unaligned.h
+ * @brief       stvlx / stvrx without byte loops (from sasrt-nx, 2026-10-14; idea 5 of sa2-nx's list; banjo-nx's copy)
+ *
+ * The generator writes the left and right unaligned vector stores as loops of single-byte stores:
+ *   stvlx vS,EA:  for (i = 0; i < 16 - (EA & 15); i++) MEM[EA + i]     = vS.u8[15 - i]   (guest bytes 0.. of vS)
+ *   stvrx vS,EA:  for (i = 0; i < (EA & 15); i++)      MEM[EA - i - 1] = vS.u8[i]        (its last EA & 15 bytes)
+ * (a register's guest byte j is u8[15 - j]). tools/vec_unaligned_stores.py writes them as REX_STVLX / REX_STVRX, which
+ * reverse the vector once and store the same bytes with at most five stores of 16, 8, 4, 2 and 1 bytes.
+ *
+ * Exact: every byte the loop writes gets the same value, and no other byte is written.
+ *   left:  b[j] = u8[15 - j], and MEM[EA + j] = b[j] for j < 16 - (EA & 15), the loop's bytes;
+ *   right: with k = EA & 15 and block = EA & ~15, MEM[block + m] = b[16 - k + m] = u8[k - 1 - m] for m < k, which is
+ *          the loop's MEM[EA - i - 1] = u8[i] with m = k - 1 - i.
+ * The range stays inside EA's 16-byte block, which never straddles 0xE0000000 (the host offset of that view), so one
+ * host address serves the whole range. Only the order of the byte writes differs, which another thread reading the
+ * block in the middle of the store could see (these are ordinary data stores, never hardware registers).
+ *
+ * Tested by sdk/tests/vec_unaligned_test.cpp (every alignment against the loops).
+ */
+#pragma once
+
+#include <cstdint>
+
+namespace rex::ppc {
+
+/// The guest byte order of a vector register's 16 bytes (u8[15 - j] is guest byte j). The register is copied to a
+/// local first, so the compiler knows it cannot overlap `b` (otherwise GCC adds an overlap test and a byte path).
+[[gnu::always_inline]] inline void GuestBytes(const uint8_t* u8, uint8_t* b) noexcept {
+  uint8_t in[16];
+  __builtin_memcpy(in, u8, 16);
+  for (int j = 0; j < 16; ++j) b[j] = in[15 - j];
+}
+
+/// 1 <= n <= 16 bytes from s to d, at most five stores.
+[[gnu::always_inline]] inline void StoreBytes(uint8_t* d, const uint8_t* s, uint32_t n) noexcept {
+  if (n == 16) {
+    __builtin_memcpy(d, s, 16);
+    return;
+  }
+  if (n & 8) {
+    __builtin_memcpy(d, s, 8);
+    d += 8;
+    s += 8;
+  }
+  if (n & 4) {
+    __builtin_memcpy(d, s, 4);
+    d += 4;
+    s += 4;
+  }
+  if (n & 2) {
+    __builtin_memcpy(d, s, 2);
+    d += 2;
+    s += 2;
+  }
+  if (n & 1) *d = *s;
+}
+
+/// stvlx: `host` is the host address of `ea`; the guest bytes 0 .. 15 - (ea & 15) of the vector at ea, upward.
+[[gnu::always_inline]] inline void StoreVectorLeft(uint8_t* host, uint32_t ea, const uint8_t* u8) noexcept {
+  uint8_t b[16];
+  GuestBytes(u8, b);
+  StoreBytes(host, b, 16 - (ea & 15));
+}
+
+/// stvrx: `block` is the host address of ea & ~15; the vector's last ea & 15 guest bytes at the start of the block.
+[[gnu::always_inline]] inline void StoreVectorRight(uint8_t* block, uint32_t ea, const uint8_t* u8) noexcept {
+  const uint32_t k = ea & 15;
+  if (!k) return;
+  uint8_t b[16];
+  GuestBytes(u8, b);
+  StoreBytes(block, b + 16 - k, k);
+}
+
+}  // namespace rex::ppc
